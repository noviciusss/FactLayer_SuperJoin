# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
VISION_MODEL=llama-3.2-11b-vision-preview

# Optional OpenAI / Azure fallback
OPENAI_API_KEY=

# Local / Docker Storage
DATABASE_URL=sqlite:///./data/fact_layer.db
# For Docker Postgres, use:
# DATABASE_URL=postgresql://postgres:password123@localhost:5432/fact_layer

# Qdrant Vector Store
# Leave empty for embedded local storage under data/qdrant
QDRANT_URL=
# For Docker Qdrant, use:
# QDRANT_URL=http://localhost:6333

# Embeddings & Tuning
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SIMILARITY_THRESHOLD=0.72
MAX_EXTRACTION_WORKERS=4
